rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /players/{playerId} {
      allow read, write: if true;
    }
    match /matches/{matchId} {
      allow read, write: if true;
    }
    match /upcoming_matches/{upcomingId} {
      allow read, write: if true;
    }
    match /individual_awards/{awardId} {
      allow read, write: if true;
    }
    match /tasks/{taskId} {
      allow read, write: if true;
    }
    match /community_videos/{videoId} {
      allow read, write: if true;
      match /chunks/{chunkId} {
        allow read, write: if true;
      }
    }
    match /promo_video/{id} {
      allow read, write: if true;
      match /chunks/{chunkId} {
        allow read, write: if true;
      }
    }
    match /fc_mobile_cards/{cardId} {
      allow read, write: if true;
    }
    match /tactics/{conditionId} {
      allow read, write: if true;
    }
    match /_connection_check_/{healthId} {
      allow read, write: if true;
    }
  }
}
